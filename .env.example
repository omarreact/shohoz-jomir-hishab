# =============================================================================
# Land records provider
# =============================================================================
# Local development defaults to the mock provider.
# Production defaults to DLRMS unless this is explicitly set to "mock".
LAND_RECORD_PROVIDER=dlrms

# Optional server-only override. Normally the app obtains and renews the
# official short-lived public DLRMS application session automatically.
# Never prefix this with NEXT_PUBLIC_.
DLRMS_ACCESS_TOKEN=

# Optional list-field enrichment. Only enable a third-party/mirror source when
# LandBD has permission to use that service and its terms allow the integration.
DLRMS_ENRICH_ENABLED=0
DLRMS_ENRICH_BASE_URL=

# =============================================================================
# LISF authorized land-information enrichment (server-only)
# =============================================================================
# Keep disabled until LandBD has official application/service registration and
# the current authority-issued authentication/signing contract is confirmed.
# The app fails closed: no private LISF request is made while disabled.
LISF_ENABLED=0

# Development can use "mock" to exercise the FullKhatian UI without requesting
# private government data. Use "official" only with authorized credentials.
LISF_PROVIDER=official
LISF_BASE_URL=https://api.land.gov.bd/live

# Official credentials belong only in protected server environment variables.
# NEVER expose these with NEXT_PUBLIC_*, commit real values, or log them.
LISF_SERVICE_ID=
LISF_ACCESS_CODE=
LISF_SIGNING_SECRET=

# =============================================================================
# RAJUK ArcGIS authentication (server-only — never use NEXT_PUBLIC_)
# =============================================================================

# Preferred: authorized ArcGIS Portal username + password.
# Generates a fresh portal token, then exchanges it for a federated server token.
RAJUK_PORTAL_USERNAME=
RAJUK_PORTAL_PASSWORD=

# Alternative: static portal token that can be exchanged for a server token.
# Prefer username/password above so tokens do not silently expire.
RAJUK_PORTAL_TOKEN=

# Legacy alias of RAJUK_PORTAL_TOKEN (still supported).
RAJUK_API_KEY=

# Optional temporary/bootstrap server token (Token 2).
# Use only if portal exchange is unavailable. Without RAJUK_SERVER_TOKEN_EXPIRES_AT,
# the app treats it as valid for one hour.
RAJUK_SERVER_TOKEN=
RAJUK_SERVER_TOKEN_EXPIRES_AT=

# =============================================================================
# Optional Redis token cache (Upstash)
# =============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Optional exporter settings
# =============================================================================
RAJUK_EXPORT_LAYER_ID=1
RAJUK_EXPORT_PAGE_SIZE=500
RAJUK_EXPORT_OUT=./exports/rajuk-layer-1.geojson

# =============================================================================
# Firebase Client (browser — NEXT_PUBLIC_*)
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emergency only: treat this email as Super Admin when no role is set.
# Leave false / unset in production.
NEXT_PUBLIC_ALLOW_BOOTSTRAP_ADMIN=false
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=admin@landbd.com

# =============================================================================
# Firebase Admin SDK (server-only — never expose to the client)
# From Firebase Console → Project settings → Service accounts → Generate key
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value; keep \n escapes or wrap in quotes with real newlines
FIREBASE_PRIVATE_KEY=
