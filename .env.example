# Valid ArcGIS Portal Token (Token 1) authorized to exchange for the federated RAJUK Server token.
# Server-side only. Never use NEXT_PUBLIC_.
# Preferred for automatic Portal -> Server token exchange.
RAJUK_PORTAL_TOKEN=

# Optional temporary/bootstrap Token 2. Use only if Portal token exchange is unavailable.
# Never expose this to the browser. If provided without RAJUK_SERVER_TOKEN_EXPIRES_AT,
# the application treats it as valid for one hour.
RAJUK_SERVER_TOKEN=
RAJUK_SERVER_TOKEN_EXPIRES_AT=

# Legacy alias supported by the code for existing deployments.
RAJUK_API_KEY=

# Upstash Redis REST credentials. Server-side only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional exporter settings
RAJUK_EXPORT_LAYER_ID=1
RAJUK_EXPORT_PAGE_SIZE=500
RAJUK_EXPORT_OUT=./exports/rajuk-layer-1.geojson
