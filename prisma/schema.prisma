datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String
  name           String?
  isVerified     Boolean   @default(false)
  role           String    @default("Basic User") // Enum in Phase 11
  
  // Security fields
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLogin      DateTime?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions       Session[]
  devices        Device[]
  loginHistory   LoginHistory[]
  notifications  Notification[]
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  refreshToken String    @unique // Opaque token stored in HttpOnly cookie
  familyId     String    // Used for token rotation detection
  expiresAt    DateTime
  
  isRevoked    Boolean   @default(false)
  deviceId     String?
  device       Device?   @relation(fields: [deviceId], references: [id])
  
  createdAt    DateTime  @default(now())
}

model Device {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  deviceId     String    // Unique identifier for the client device
  userAgent    String?
  ipAddress    String?
  lastActive   DateTime  @default(now())
  
  sessions     Session[]
}

model LoginHistory {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  status       String    // "SUCCESS" | "FAILED"
  ipAddress    String?
  userAgent    String?
  
  createdAt    DateTime  @default(now())
}

// Phase 5: Search & Unified Caching
model RajukPlot {
  id           String    @id @default(uuid())
  plotNo       String
  ownerName    String?
  mouza        String?
  khatiyanNo   String?
  landType     String?
  area         Float?
  
  // JSON data to store the raw ESRI feature geometry or complex metadata
  rawFeature   String?   

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([plotNo])
  @@index([khatiyanNo])
  @@index([mouza])
}

// Phase 7: Notification System
model Notification {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title        String
  message      String
  type         String    @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  isRead       Boolean   @default(false)
  link         String?
  
  createdAt    DateTime  @default(now())
}

// Blog system (replaces Firestore "blogs" collection)
model Blog {
  id           String    @id @default(uuid())
  title        String
  slug         String    @unique
  excerpt      String?
  content      String
  coverImage   String?
  author       String    @default("মো. ওমর ফারুক")
  category     String    @default("সাধারণ")
  categorySlug String    @default("general")
  status       String    @default("Published") // Published | Draft
  readingTime  String?
  tags         String    @default("[]") // JSON array stored as string

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  comments     BlogComment[]

  @@index([slug])
  @@index([categorySlug])
  @@index([status])
}

// Blog comments (replaces Firestore "comments" collection)
model BlogComment {
  id        String   @id @default(uuid())
  blogId    String
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  name      String
  text      String
  createdAt DateTime @default(now())

  @@index([blogId])
}

// Custom/dynamic pages (replaces Firestore "dynamic_pages" collection)
model CustomPage {
  id        String   @id @default(uuid())
  title     String
  slug      String   @unique
  category  String   @default("সাধারণ (General)")
  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

// Key-value site settings (replaces Firestore "config" collection)
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
