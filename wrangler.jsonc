{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "landbd-app",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vars": {
    "NEXTJS_ENV": "production",
    "LANDBD_PLATFORM": "cloudflare-workers",
    "LANDBD_ENV": "staging",
    "LAND_EXPORT_STORAGE_PROVIDER": "cloudflare"
  },
  "previews": {
    "vars": {
      "NEXTJS_ENV": "production",
      "LANDBD_PLATFORM": "cloudflare-workers-preview",
      "LANDBD_ENV": "staging-preview",
      "LAND_EXPORT_STORAGE_PROVIDER": "cloudflare"
    },
    "d1_databases": [
      {
        "binding": "NEXT_TAG_CACHE_D1",
        "database_name": "landbd-preview-next-tags",
        "database_id": "7ea7a4fe-086b-488b-8c5a-a4e42f603351"
      }
    ],
    "r2_buckets": [
      {
        "binding": "LANDBD_FILES",
        "bucket_name": "landbd-vinext-stage-files"
      },
      {
        "binding": "NEXT_INC_CACHE_R2_BUCKET",
        "bucket_name": "landbd-preview-next-cache"
      }
    ],
    "placement": {
      "mode": "smart"
    }
  },
  "r2_buckets": [
    {
      "binding": "LANDBD_FILES",
      "bucket_name": "landbd-files"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "landbd-next-cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "landbd-next-tags",
      "database_id": "71c651eb-6f52-4b92-ab9e-457145992d30"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "landbd-app"
    }
  ]
}
